{
  "name": "halo-record",
  "version": "0.2.39",
  "description": "Open, tamper-evident audit trails for AI agents \u2014 hash-chained Runtime Records, dependency-free, verifiable by anyone. Chain-format compatible with the Python halo-record package.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "halo-record.schema.json"
  ],
  "scripts": {
    "test": "node --test test/core.test.ts test/integrations.test.ts test/timestamp.test.ts test/concurrency.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.13.1",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkuan001/halo-record-ts.git"
  },
  "homepage": "https://github.com/bkuan001/halo-record-ts#readme",
  "bugs": {
    "url": "https://github.com/bkuan001/halo-record-ts/issues"
  },
  "author": "Brian Kuan",
  "keywords": [
    "ai",
    "agents",
    "audit",
    "tamper-evident",
    "attestation",
    "compliance",
    "hash-chain",
    "runtime-records"
  ]
}